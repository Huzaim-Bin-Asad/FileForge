# Postgres connection string (Neon)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/fileforge?sslmode=require

# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-32

# Generate with: openssl rand -base64 32 (must differ from JWT_ACCESS_SECRET)
TOKEN_PEPPER=replace-with-a-different-openssl-rand-base64-32

# Public app URL (used for OAuth redirects)
APP_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com/api-keys) — sends the password-reset email.
# Without this, reset links are only logged server-side (fine for local dev,
# not for production).
RESEND_API_KEY=
# Must be on a domain verified in Resend once you're past their sandbox sender.
EMAIL_FROM="FileForge <onboarding@resend.dev>"

# Upstash Redis (https://console.upstash.com) — optional. Rate-limits login,
# signup, and forgot-password. Skipped with a warning if left unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
