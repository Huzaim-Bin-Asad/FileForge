# Postgres connection string (Neon)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/fileforge?sslmode=require #done don't change this

# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-32   #done don't change this

# Generate with: openssl rand -base64 32 (must differ from JWT_ACCESS_SECRET)
TOKEN_PEPPER=replace-with-a-different-openssl-rand-base64-32 #done don't change this

# Public app URL (used for OAuth redirects)
APP_URL=http://localhost:3000  #done don't change this

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=  #done don't change this
GOOGLE_CLIENT_SECRET=  #done don't change this

# Resend (https://resend.com/api-keys) — sends the password-reset email.
# Without this, reset links are only logged server-side (fine for local dev,
# not for production).
RESEND_API_KEY=
# Must be on a domain verified in Resend once you're past their sandbox sender.
EMAIL_FROM="FileForge <onboarding@resend.dev>"

# Upstash Redis (https://console.upstash.com) — optional. Rate-limits login,
# signup, and forgot-password. Skipped with a warning if left unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (Vercel dashboard -> Storage -> Blob) — stores conversion inputs
# and outputs. The store MUST be created as a *private* store. Server-only:
# never prefix this with NEXT_PUBLIC_. Without it, new conversions fall back to
# the legacy Postgres bytea column (with a logged warning).
BLOB_READ_WRITE_TOKEN=
